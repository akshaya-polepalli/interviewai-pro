# =============================================================================
# InterviewAI Pro — Environment Template
# Copy to .env and fill in values. NEVER commit real secrets.
# =============================================================================

# ----- App -----
APP_NAME=InterviewAI Pro
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS (comma-separated origins) -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ----- Database -----
POSTGRES_USER=interviewai
POSTGRES_PASSWORD=interviewai_dev_password
POSTGRES_DB=interviewai
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://interviewai:interviewai_dev_password@postgres:5432/interviewai

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- Object storage (local now, S3-compatible later) -----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage/local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1
# AWS_S3_ENDPOINT_URL=

# ----- AI providers (Module 5+) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PRIMARY_PROVIDER=openai

# ----- Voice interviews (Module 12) -----
AUDIO_MAX_UPLOAD_MB=10
AUDIO_ALLOWED_CONTENT_TYPES=audio/webm,audio/wav,audio/wave,audio/x-wav,audio/mpeg,audio/mp4,audio/ogg,video/webm

# ----- Email (Module 3) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@interviewaipro.local
FRONTEND_URL=http://localhost:5173

# ----- OAuth (Module 3) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- Bootstrap admin (dev only — change in production) -----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPass1
SEED_ADMIN_NAME=Platform Admin

# ----- Demo account (Module 14) -----
SEED_DEMO_ENABLED=true
SEED_DEMO_EMAIL=demo@interviewai.local
SEED_DEMO_PASSWORD=DemoPass1
SEED_DEMO_NAME=Demo Candidate

# ----- Billing (Module 15) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_FORCE_LOCAL=true

# ----- Free / serverless deploy (Render + Neon + Upstash) -----
# When true, run jobs inline (no Celery worker required).
FORCE_SYNC_JOBS=false

# ----- Code execution (Module 7) -----
CODE_EXECUTOR_ENABLED=false
CODE_EXECUTOR_TIMEOUT_SECONDS=10
CODE_EXECUTOR_MEMORY_MB=256

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
